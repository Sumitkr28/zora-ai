# Copy to .env.local and fill in. These are baked into the static export at
# build time, so re-run `npm run sync` after changing anything here.
#
# The Firebase values are the SAME ones as zora-app/.env.local — the mobile app
# talks to the same Firebase project (zora-prod-8eed5), so an account works on
# both web and Android.

NEXT_PUBLIC_FIREBASE_API_KEY=<firebase-web-api-key>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=zora-prod-8eed5.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=zora-prod-8eed5
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=zora-prod-8eed5.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<sender-id>
NEXT_PUBLIC_FIREBASE_APP_ID=<app-id>

# Where the app sends /api/chat and /api/upload. The deployed web app.
# NO Gemini key here — it stays server-side on Vercel and never ships in the APK.
NEXT_PUBLIC_ZORA_API_BASE=https://zora-chatbot.vercel.app

# Contact form (same key as web).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=<web3forms-access-key>
