{
  "name": "zora-mobile-app",
  "version": "1.0.0",
  "private": true,
  "description": "Zora for Android — Capacitor shell around the exact zora-app UI.",
  "scripts": {
    "build": "next build",
    "verify": "node scripts/verify.mjs",
    "sync": "npm run build && npm run verify && npx cap sync android",
    "open:android": "npx cap open android",
    "run:android": "npm run sync && npx cap run android",
    "typecheck": "tsc --noEmit",
    "dev": "next dev -p 3100"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^6.3.1",
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/browser": "^6.0.3",
    "@capacitor/core": "^6.2.0",
    "@capacitor/keyboard": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "@google/generative-ai": "^0.21.0",
    "firebase": "^11.0.2",
    "framer-motion": "^11.11.17",
    "libphonenumber-js": "^1.11.14",
    "next": "^14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
